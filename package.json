{
  "name": "convex-releases",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "convex dev --start 'vite dev'",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "node .output/server/index.mjs",
    "format": "prettier --write .",
    "lint": "npm run typecheck && eslint .  --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@convex-dev/ai-sdk-provider": "0.3.0",
    "@convex-dev/auth": "2.0.0-alpha.2",
    "@convex-dev/crons": "0.2.3",
    "@tanstack/react-router": "^1.170.19",
    "@tanstack/react-start": "^1.168.36",
    "ai": "^7.0.137",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "convex": "^1.46.0",
    "convex-test": "0.0.61",
    "jose": "^6.2.12",
    "lucide-react": "^1.55.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
